# SECURITY: never put real secrets in this file; it is committed. Copy to .env and generate every CHANGE_ME value
# (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`). The app refuses to start
# with a CHANGE_ME value or with any secret that was ever published.
# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=Med4U
API_PREFIX=api
FRONTEND_URL=http://localhost:3001

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=med4u_user
DB_PASSWORD=CHANGE_ME_generate_a_random_value
DB_NAME=med4u_db
DB_SSL=false
DB_SYNC=false
DB_LOGGING=true

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_generate_a_random_value
REDIS_DB=0
REDIS_TTL=3600

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_a_random_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_random_value
JWT_REFRESH_EXPIRES_IN=7d
# Signs video-room tokens. Optional (min 32 chars); defaults to a value derived from JWT_SECRET.
CONSULTATION_TOKEN_SECRET=CHANGE_ME_generate_a_random_value

# ICE connectivity: configure a coturn-compatible REST shared secret for short-lived credentials.
# Credentials are generated per join and are not logged. STUN alone will not work on every network.
# STUN_SERVER_URL=stun:stun.l.google.com:19302
# TURN_SERVER_URL=turn:turn.example.com:3478
# TURN_SHARED_SECRET=replace-with-a-random-secret-at-least-32-characters
# TURN_CREDENTIAL_TTL_SECONDS=3600

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.invalid
SMTP_PASS=your_app_password
EMAIL_FROM=Med4U <noreply@example.invalid>

# ─── SMS / Twilio ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=20

# ─── Swagger ─────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
# Unauthenticated debug endpoints expose development data; enable only on a local dev server.
DEBUG_ROUTES_ENABLED=false
SWAGGER_PATH=api/docs

# ─── File Upload ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── WebSocket ───────────────────────────────────────────────────────────────
WS_CORS_ORIGIN=http://localhost:3001

# ─── Encryption ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_generate_a_random_value
# Key rotation: bump ENCRYPTION_KEY_ID, move the old key to ENCRYPTION_KEY_PREVIOUS (+ its id; 0 for files written
# before key ids existed), run `npm run prescriptions:reencrypt -- --apply`, then remove the previous key.
ENCRYPTION_KEY_ID=1
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_ID=0

# Encrypts doctor-application documents (licences, certificates). MUST differ from ENCRYPTION_KEY. Without it,
# doctor registration uploads are disabled (503). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# DOCUMENT_ENCRYPTION_KEY=CHANGE_ME_generate_a_different_random_value
# DOCUMENT_ENCRYPTION_KEY_ID=1
# DOCTOR_DOCUMENT_STORAGE_DIR=./storage/doctor-documents

# --- Local demo doctor login (DEVELOPMENT ONLY) ---
# Lets the reserved number 1111111112 sign in with a fixed code. The app REFUSES TO START if this is true while
# NODE_ENV is anything but "development", on a hosted platform, or with DB_SSL=true. Put these in .env.local, never
# in a deployed environment. Create the demo accounts with: npm run demo:doctor -- --confirm-db <DB_NAME> --apply
# DEMO_DOCTOR_LOGIN_ENABLED=false
# DEMO_DOCTOR_OTP=
# For local video tests, set only in .env.local to the authorized patient's users.id UUID.
# The backend never accepts this designation from an app request or returns it in an API response.
# DEMO_VIDEO_TEST_PATIENT_USER_ID=

# ─── Health / Monitoring ─────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# Private medical document storage directory. Configure a private, encrypted volume outside the web root.
# Without this setting, document uploads return PRIVATE_STORAGE_UNAVAILABLE.
# PRIVATE_FILES_DIR=/var/lib/med4u/private-medical-files

# Appointment payments are disabled until all three Razorpay values are configured.
# Keep the secret values on the backend only. Register POST /api/v1/appointments/payment-webhook
# with the payment.captured and payment.failed events, using the same webhook secret below.
# Configure automatic payment capture in the Razorpay Dashboard for confirmed bookings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
