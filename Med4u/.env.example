# Expo inlines EXPO_PUBLIC_* variables at build time. Never put secrets here.
# Copy to .env.development (used by `expo start`) and .env.production (used by builds/exports).
#
# Dev examples:
#   Android emulator -> http://10.0.2.2:3000/api
#   iOS simulator    -> http://localhost:3000/api
#   Physical device  -> http://10.157.113.194:3000/api
# Production must be https.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
